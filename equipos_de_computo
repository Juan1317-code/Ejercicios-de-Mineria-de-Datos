import pandas as pd

from sklearn.model_selection import (
    train_test_split,
    cross_val_score,
    StratifiedKFold
)
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier
from sklearn.pipeline import make_pipeline
from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    classification_report
)


df = pd.read_csv(
    "equipos_computo.csv",
    encoding="utf-8-sig"
)

print("Primeras filas del dataset:")
print(df.head())

print("\nCantidad de equipos por estado:")
print(df["Estado_Equipo"].value_counts())

print("\nDatos faltantes:")
print(df.isnull().sum())


X = df[[
    "Horas_Uso_Semanal",
    "Temperatura_CPU",
    "Uso_RAM_Porcentaje",
    "Espacio_Disco_Libre",
    "Errores_Sistema",
    "Tiempo_Arranque_Segundos"
]]


y = df["Estado_Equipo"]


X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

print("\nEquipos utilizados para entrenamiento:")
print(len(X_train))

print("\nEquipos utilizados para prueba:")
print(len(X_test))


escalador = StandardScaler()

X_train_escalado = escalador.fit_transform(X_train)
X_test_escalado = escalador.transform(X_test)


modelo = MLPClassifier(
    hidden_layer_sizes=(8, 6),
    activation="relu",
    solver="adam",
    max_iter=3000,
    random_state=42
)


modelo.fit(X_train_escalado, y_train)


predicciones = modelo.predict(X_test_escalado)


exactitud = accuracy_score(
    y_test,
    predicciones
)

print("\nExactitud del modelo:")
print(f"{exactitud * 100:.2f}%")


print("\nOrden de las categorías:")
print(modelo.classes_)

print("\nMatriz de confusión:")
print(
    confusion_matrix(
        y_test,
        predicciones,
        labels=modelo.classes_
    )
)


print("\nReporte de clasificación:")
print(
    classification_report(
        y_test,
        predicciones
    )
)


comparacion = pd.DataFrame({
    "Estado_Real": y_test.values,
    "Estado_Predicho": predicciones
})

print("\nComparación de resultados:")
print(comparacion.to_string(index=False))


validacion = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=42
)

modelo_validacion = make_pipeline(
    StandardScaler(),
    MLPClassifier(
        hidden_layer_sizes=(8, 6),
        activation="relu",
        solver="adam",
        max_iter=3000,
        random_state=42
    )
)

resultados_validacion = cross_val_score(
    modelo_validacion,
    X,
    y,
    cv=validacion,
    scoring="accuracy"
)

print("\nResultados de las cinco validaciones:")
print(resultados_validacion)

print("\nExactitud promedio de la validación cruzada:")
print(f"{resultados_validacion.mean() * 100:.2f}%")


nuevos_equipos = pd.DataFrame({
    "Horas_Uso_Semanal": [15, 30, 42, 55, 68],
    "Temperatura_CPU": [38, 50, 65, 78, 92],
    "Uso_RAM_Porcentaje": [35, 50, 68, 85, 97],
    "Espacio_Disco_Libre": [450, 250, 120, 45, 10],
    "Errores_Sistema": [0, 2, 5, 11, 20],
    "Tiempo_Arranque_Segundos": [25, 42, 70, 110, 160]
})


nuevos_equipos_escalados = escalador.transform(
    nuevos_equipos
)

predicciones_nuevas = modelo.predict(
    nuevos_equipos_escalados
)


probabilidades = modelo.predict_proba(
    nuevos_equipos_escalados
)

nuevos_equipos["Estado_Predicho"] = (
    predicciones_nuevas
)

nuevos_equipos["Confianza"] = (
    probabilidades.max(axis=1) * 100
).round(2)

nuevos_equipos.insert(
    0,
    "Equipo",
    [
        "Equipo 1",
        "Equipo 2",
        "Equipo 3",
        "Equipo 4",
        "Equipo 5"
    ]
)

print("\nCinco predicciones de estado:")
print(nuevos_equipos.to_string(index=False))

